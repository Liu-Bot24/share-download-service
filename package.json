{
  "name": "share-files-verification",
  "private": true,
  "scripts": {
    "test:core": "php tests/run.php",
    "test:http": "python3 tests/http_test.py",
    "test:browser": "node tests/browser.mjs",
    "format:php": "prettier --plugin=@prettier/plugin-php --write 'src/*.php' 'scripts/*.php' 'public/index.php' 'tests/*.php'"
  },
  "devDependencies": {
    "@prettier/plugin-php": "0.24.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2"
  },
  "engines": {"node": ">=20"}
}
